{
  "name": "crazy-capital",
  "version": "0.0.1",
  "private": true,
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "npm run --workspace=@cc/api dev",
    "dev:admin": "npm run --workspace=@cc/admin dev",
    "dev:web": "npm run --workspace=@cc/web dev",
    "db:generate": "npm run --workspace=@cc/api prisma:generate",
    "db:push": "npx --workspace=@cc/api prisma db push",
    "db:seed": "npm run --workspace=@cc/api prisma:seed",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:browser": "node scripts/browser-acceptance-suite.js",
    "start:stack": "node scripts/start-local-stack.js",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "node -e \"try { require('husky') } catch (e) {}\""
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "next": "15.3.3",
    "playwright-core": "^1.62.1",
    "prettier": "^3.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,json}": "prettier --write"
  }
}
