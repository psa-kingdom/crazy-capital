# Application
PORT=4000
NODE_ENV=development
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crazy_capital?schema=public"

# Authentication / Security
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=super-secret-refresh-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Cloudflare R2 (Storage - Phase 1)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=crazy-capital-documents
R2_PUBLIC_DOMAIN=

# Razorpay (Payments)
RAZORPAY_KEY_ID=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Resend (Email)
RESEND_API_KEY=

# MSG91 (SMS)
MSG91_API_KEY=
MSG91_SENDER_ID=

# Interakt (WhatsApp)
INTERAKT_API_KEY=
