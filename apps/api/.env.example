# ==============================================================================
# Crazy Capital API Environment Configuration Template
# Copy this file to .env or .env.local for local development.
# In production, set these variables securely in the deployment provider (Railway).
# ==============================================================================

# Application
PORT=4000
NODE_ENV=development
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000,https://crazycapital.in

# Database (PostgreSQL)
# Required in all environments.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crazy_capital?schema=public"

# Authentication & IAM (Argon2 & JWT)
# In production: Secrets MUST be >= 32 characters and NOT match development placeholders.
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=super-secret-refresh-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Cloudflare R2 (Secure Document Vault - Slice 1.7)
# Optional in dev: Falls back to deterministic local mock storage if omitted.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=crazy-capital-documents
R2_PUBLIC_DOMAIN=

# Razorpay (Customer Invoicing & Payments - Slice 1.8)
# Optional in dev: Falls back to development mock gateway (order_mock_...) if omitted.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# RazorpayX (Automated Partner Payouts - Slice 2.5)
# Optional in dev: Falls back to simulated payout execution with realistic UTRs if omitted.
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=2323230045678901

# Transactional Email (Resend - Slice 1.10)
# Optional in dev: Falls back to console log mock dispatch if omitted.
RESEND_API_KEY=
EMAIL_FROM=Crazy Capital <notifications@crazycapital.in>

# Transactional SMS & OTP (MSG91 - Slice 1.10)
# Optional in dev: Falls back to console log mock dispatch if omitted.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=CRZYCP
MSG91_DLT_TE_ID=

# WhatsApp Business (Interakt - Slice 1.10)
# Optional in dev: Falls back to console log mock dispatch if omitted.
INTERAKT_API_KEY=
INTERAKT_BASE_URL=https://api.interakt.ai/v1/public/message/

# Statutory Identity Verification (Slice 3.4)
# Optional in dev: Falls back to deterministic sandbox simulation if omitted.
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
SUREPASS_API_TOKEN=

# Workflow SLA Engine (Slice 2.2)
SLA_EVAL_INTERVAL_MS=60000
