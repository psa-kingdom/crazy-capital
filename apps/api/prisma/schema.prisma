datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── DOMAIN 1: ORGANIZATION DOMAIN ──────────────────────────────────────────

model Organization {
  id         String    @id @default(uuid())
  name       String
  legalName  String?   @map("legal_name")
  code       String    @unique
  status     String    @default("ACTIVE") // ACTIVE, SUSPENDED, INACTIVE
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  branches     Branch[]
  departments  Department[]
  users        User[]
  leads        Lead[]
  customers    Customer[]
  applications Application[]
  documents    Document[]
  blogCategories BlogCategory[]
  blogPosts    BlogPost[]

  @@map("organizations")
}

model Branch {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  name           String
  code           String
  city           String?
  state          String?
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departments  Department[]
  users        User[]
  leads        Lead[]
  customers    Customer[]
  applications Application[]
  documents    Document[]

  @@unique([organizationId, code])
  @@map("branches")
}

model Department {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  branchId       String?   @map("branch_id")
  name           String
  description    String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  teams        Team[]

  @@map("departments")
}

model Team {
  id           String    @id @default(uuid())
  departmentId String    @map("department_id")
  name         String
  description  String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@map("teams")
}

// ─── DOMAIN 2: IDENTITY & ACCESS DOMAIN ─────────────────────────────────────

model User {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  branchId       String?   @map("branch_id")
  firstName      String    @map("first_name")
  lastName       String    @map("last_name")
  email          String    @unique
  mobile         String?
  passwordHash   String    @map("password_hash")
  status         String    @default("ACTIVE") // ACTIVE, INACTIVE, BLOCKED
  lastLoginAt    DateTime? @map("last_login_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  userRoles    UserRole[]
  userSessions UserSession[]

  assignedLeads         Lead[]                  @relation("AssignedLeads")
  leadActivities        LeadActivity[]          @relation("UserLeadActivities")
  assignedApplications  Application[]           @relation("AssignedApplications")
  applicationActivities ApplicationActivity[]   @relation("UserApplicationActivities")
  workflowTransitions   WorkflowHistory[]       @relation("UserWorkflowHistory")
  verifiedDocuments     DocumentVerification[]  @relation("UserVerifiedDocuments")
  approvedCommissions   Commission[]            @relation("AdminApprovedCommissions")
  partnerCommissions    Commission[]            @relation("PartnerCommissions")
  partnerPayouts        Payout[]                @relation("PartnerPayouts")
  partnerLeads          Lead[]                  @relation("PartnerLeads")
  partnerApplications   Application[]           @relation("PartnerApplications")
  assignedTasks         Task[]                  @relation("AssignedTasks")
  blogPosts             BlogPost[]              @relation("AuthorBlogPosts")

  @@index([organizationId, email])
  @@index([organizationId, mobile])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique // SUPER_ADMIN, ADMIN, BRANCH_MANAGER, EMPLOYEE, PARTNER, CUSTOMER
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique // e.g. "lead.view", "lead.create", "commission.approve"
  module      String   // e.g. "lead", "customer", "workflow", "commission"
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserSession {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  refreshToken String    @map("refresh_token")
  deviceName   String?   @map("device_name")
  ipAddress    String?   @map("ip_address")
  userAgent    String?   @map("user_agent")
  expiresAt    DateTime  @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  revokedAt    DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, refreshToken])
  @@map("user_sessions")
}

// ─── DOMAIN 3: CRM DOMAIN (LEADS & CUSTOMERS) ───────────────────────────────

// ADR-013: Lead sources are Admin-configurable, not a hardcoded enum
model LeadSource {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  leads Lead[]

  @@map("lead_sources")
}

model Lead {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  branchId       String?   @map("branch_id")
  sourceId       String?   @map("source_id")
  assignedToId   String?   @map("assigned_to_id")
  firstName      String    @map("first_name")
  lastName       String    @map("last_name")
  email          String?
  mobile         String
  companyName    String?   @map("company_name")
  status         String    @default("NEW") // NEW, CONTACTED, QUALIFIED, PROPOSAL, CONVERTED, LOST
  leadScore      Int       @default(0) @map("lead_score")
  notes          String?
  campaign       String?
  utmSource      String?   @map("utm_source")
  utmMedium      String?   @map("utm_medium")
  utmCampaign    String?   @map("utm_campaign")
  serviceInterest String?  @map("service_interest")
  partnerId      String?   @map("partner_id") // userId with PARTNER role who referred lead
  convertedToId  String?   @map("converted_to_id") // customer_id if converted
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  source       LeadSource?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  assignedTo   User?        @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)
  partner      User?        @relation("PartnerLeads", fields: [partnerId], references: [id], onDelete: SetNull)
  activities   LeadActivity[]
  assignments  LeadAssignment[]

  @@index([organizationId, status])
  @@index([organizationId, mobile])
  @@index([partnerId])
  @@map("leads")
}

model LeadActivity {
  id          String   @id @default(uuid())
  leadId      String   @map("lead_id")
  performedById String? @map("performed_by_id")
  activityType String  @map("activity_type") // CALL, EMAIL, WHATSAPP, MEETING, NOTE, STATUS_CHANGE
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  lead        Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  performedBy User? @relation("UserLeadActivities", fields: [performedById], references: [id], onDelete: SetNull)

  @@map("lead_activities")
}

model LeadAssignment {
  id           String   @id @default(uuid())
  leadId       String   @map("lead_id")
  assignedFrom String?  @map("assigned_from")
  assignedTo   String   @map("assigned_to")
  assignedAt   DateTime @default(now()) @map("assigned_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("lead_assignments")
}

model Customer {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  branchId       String?   @map("branch_id")
  customerType   String    @default("INDIVIDUAL") @map("customer_type") // INDIVIDUAL, BUSINESS
  firstName      String    @map("first_name")
  lastName       String    @map("last_name")
  email          String
  mobile         String
  companyName    String?   @map("company_name")
  pan            String?
  gstin          String?
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  addresses    CustomerAddress[]
  contacts     CustomerContact[]
  applications Application[]
  documents    Document[]
  invoices     Invoice[]

  @@unique([organizationId, email])
  @@unique([organizationId, mobile])
  @@map("customers")
}

model CustomerAddress {
  id           String   @id @default(uuid())
  customerId   String   @map("customer_id")
  type         String   @default("REGISTERED") // REGISTERED, BILLING, MAILING
  addressLine1 String   @map("address_line_1")
  addressLine2 String?  @map("address_line_2")
  city         String
  state        String
  country      String   @default("India")
  pincode      String
  createdAt    DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_addresses")
}

model CustomerContact {
  id          String   @id @default(uuid())
  customerId  String   @map("customer_id")
  name        String
  mobile      String
  email       String?
  designation String?
  createdAt   DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_contacts")
}

// ─── DOMAIN 4: SERVICE CATALOG DOMAIN ───────────────────────────────────────

model ServiceCategory {
  id          String   @id @default(uuid())
  parentId    String?  @map("parent_id")
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  parent   ServiceCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children ServiceCategory[] @relation("CategoryHierarchy")
  services Service[]

  @@map("service_categories")
}

model Service {
  id          String   @id @default(uuid())
  categoryId  String   @map("category_id")
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  category         ServiceCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  pricing          ServicePricing[]
  requiredDocuments ServiceDocument[]
  workflow         Workflow?         // ADR-012: 1:1 relation with workflow
  applications     Application[]
  commissions      Commission[]

  @@map("services")
}

model ServicePricing {
  id            String    @id @default(uuid())
  serviceId     String    @map("service_id")
  pricingType   String    @default("STANDARD") @map("pricing_type") // STANDARD, PARTNER, PROMOTIONAL
  amount        Decimal   @db.Decimal(12, 2)
  effectiveFrom DateTime  @default(now()) @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  createdAt     DateTime  @default(now()) @map("created_at")

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("service_pricing")
}

model ServiceDocument {
  id             String  @id @default(uuid())
  serviceId      String  @map("service_id")
  documentTypeId String  @map("document_type_id")
  isMandatory    Boolean @default(true) @map("is_mandatory")

  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  documentType DocumentType @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)

  @@unique([serviceId, documentTypeId])
  @@map("service_documents")
}

// ─── DOMAIN 5 & 6: APPLICATION & WORKFLOW DOMAIN ────────────────────────────

model Application {
  id                String    @id @default(uuid())
  organizationId    String    @map("organization_id")
  branchId          String?   @map("branch_id")
  customerId        String    @map("customer_id")
  serviceId         String    @map("service_id")
  applicationNumber String    @unique @map("application_number")
  status            String    @default("SUBMITTED") // DRAFT, SUBMITTED, IN_PROGRESS, COMPLETED, CANCELLED, REJECTED
  assignedToId      String?   @map("assigned_to_id")
  partnerId         String?   @map("partner_id") // userId with PARTNER role who referred
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?               @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customer     Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service      Service               @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  assignedTo   User?                 @relation("AssignedApplications", fields: [assignedToId], references: [id], onDelete: SetNull)
  partner      User?                 @relation("PartnerApplications", fields: [partnerId], references: [id], onDelete: SetNull)
  workflowInstance WorkflowInstance?
  activities   ApplicationActivity[]
  documents    Document[]
  invoices     Invoice[]
  commissions  Commission[]
  tasks        Task[]

  @@index([organizationId, status])
  @@index([partnerId])
  @@map("applications")
}

model ApplicationActivity {
  id            String   @id @default(uuid())
  applicationId String   @map("application_id")
  performedById String?  @map("performed_by_id")
  activityType  String   @map("activity_type")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  performedBy User?       @relation("UserApplicationActivities", fields: [performedById], references: [id], onDelete: SetNull)

  @@map("application_activities")
}

// ADR-012: One service has exactly one workflow (1:1)
model Workflow {
  id          String   @id @default(uuid())
  serviceId   String   @unique @map("service_id")
  name        String
  code        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  service     Service               @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  stages      WorkflowStage[]
  transitions WorkflowTransition[]
  instances   WorkflowInstance[]

  @@map("workflows")
}

model WorkflowStage {
  id           String   @id @default(uuid())
  workflowId   String   @map("workflow_id")
  name         String
  code         String
  stageOrder   Int      @map("stage_order")
  stageType    String   @default("PROCESSING") @map("stage_type") // START, PROCESSING, APPROVAL, COMPLETION, REJECTION
  isStartStage Boolean  @default(false) @map("is_start_stage")
  isEndStage   Boolean  @default(false) @map("is_end_stage")
  isMandatory  Boolean  @default(true) @map("is_mandatory")
  slaHours     Int?     @map("sla_hours")
  warningHours Int?     @map("warning_hours")
  department   String?  @map("department")
  canvasX      Float?   @map("canvas_x")
  canvasY      Float?   @map("canvas_y")
  createdAt    DateTime @default(now()) @map("created_at")

  workflow         Workflow             @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  rules            WorkflowRule[]
  fromTransitions  WorkflowTransition[] @relation("FromStage")
  toTransitions    WorkflowTransition[] @relation("ToStage")
  currentInstances WorkflowInstance[]   @relation("CurrentStage")
  tasks            Task[]

  @@unique([workflowId, stageOrder])
  @@unique([workflowId, code])
  @@map("workflow_stages")
}

model WorkflowTransition {
  id               String   @id @default(uuid())
  workflowId       String   @map("workflow_id")
  fromStageId      String   @map("from_stage_id")
  toStageId        String   @map("to_stage_id")
  requiresApproval Boolean  @default(false) @map("requires_approval")
  conditionLabel   String?  @map("condition_label")
  createdAt        DateTime @default(now()) @map("created_at")

  workflow  Workflow      @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  fromStage WorkflowStage @relation("FromStage", fields: [fromStageId], references: [id], onDelete: Cascade)
  toStage   WorkflowStage @relation("ToStage", fields: [toStageId], references: [id], onDelete: Cascade)

  @@unique([workflowId, fromStageId, toStageId])
  @@map("workflow_transitions")
}

model WorkflowRule {
  id         String @id @default(uuid())
  stageId    String @map("stage_id")
  ruleType   String @map("rule_type") // DOCUMENT_GATE, PAYMENT_GATE, APPROVAL_GATE
  ruleConfig Json   @map("rule_config")

  stage WorkflowStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@map("workflow_rules")
}

model WorkflowInstance {
  id             String    @id @default(uuid())
  workflowId     String    @map("workflow_id")
  applicationId  String    @unique @map("application_id")
  currentStageId String    @map("current_stage_id")
  startedAt      DateTime  @default(now()) @map("started_at")
  completedAt    DateTime? @map("completed_at")

  workflow     Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  application  Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  currentStage WorkflowStage     @relation("CurrentStage", fields: [currentStageId], references: [id])
  history      WorkflowHistory[]
  approvals    Approval[]

  @@map("workflow_instances")
}

model WorkflowHistory {
  id                 String   @id @default(uuid())
  workflowInstanceId String   @map("workflow_instance_id")
  fromStageId        String   @map("from_stage_id")
  toStageId          String   @map("to_stage_id")
  performedById      String?  @map("performed_by_id")
  remarks            String?
  createdAt          DateTime @default(now()) @map("created_at")

  instance    WorkflowInstance @relation(fields: [workflowInstanceId], references: [id], onDelete: Cascade)
  performedBy User?            @relation("UserWorkflowHistory", fields: [performedById], references: [id], onDelete: SetNull)

  @@map("workflow_history")
}

model Task {
  id              String    @id @default(uuid())
  applicationId   String    @map("application_id")
  workflowStageId String?   @map("workflow_stage_id")
  assignedToId    String?   @map("assigned_to_id")
  title           String
  description     String?
  status          String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, CANCELLED
  dueDate         DateTime? @map("due_date")
  completedAt     DateTime? @map("completed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  application   Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  workflowStage WorkflowStage? @relation(fields: [workflowStageId], references: [id], onDelete: SetNull)
  assignedTo    User?          @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@map("tasks")
}

model Approval {
  id                 String    @id @default(uuid())
  workflowInstanceId String    @map("workflow_instance_id")
  stageId            String    @map("stage_id")
  requestedById      String    @map("requested_by_id")
  approvedById       String?   @map("approved_by_id")
  status             String    @default("PENDING") // PENDING, APPROVED, REJECTED
  remarks            String?
  approvedAt         DateTime? @map("approved_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  instance WorkflowInstance @relation(fields: [workflowInstanceId], references: [id], onDelete: Cascade)

  @@map("approvals")
}

// ─── DOMAIN 7: DOCUMENT DOMAIN ──────────────────────────────────────────────

model DocumentType {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique // PAN, AADHAAR, GST_CERTIFICATE, PASSPORT, ITR_V, BANK_STATEMENT
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  serviceDocuments ServiceDocument[]
  documents        Document[]

  @@map("document_types")
}

model Document {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  branchId       String?   @map("branch_id")
  customerId     String    @map("customer_id")
  applicationId  String?   @map("application_id")
  documentTypeId String    @map("document_type_id")
  fileName       String    @map("file_name")
  filePath       String    @map("file_path") // R2 key
  fileSize       Int       @map("file_size")
  mimeType       String    @map("mime_type")
  status         String    @default("PENDING") // PENDING, UPLOADED, VERIFIED, REJECTED
  uploadedById   String?   @map("uploaded_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customer     Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  application  Application?           @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  documentType DocumentType           @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)
  verifications DocumentVerification[]

  @@map("documents")
}

model DocumentVerification {
  id           String    @id @default(uuid())
  documentId   String    @map("document_id")
  verifiedById String?   @map("verified_by_id")
  status       String    // VERIFIED, REJECTED
  remarks      String?
  verifiedAt   DateTime  @default(now()) @map("verified_at")

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  verifiedBy User?    @relation("UserVerifiedDocuments", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@map("document_verifications")
}

// ─── DOMAIN 8 & 9: PAYMENT & COMMISSION DOMAINS ─────────────────────────────

model Invoice {
  id             String    @id @default(uuid())
  customerId     String    @map("customer_id")
  applicationId  String?   @map("application_id")
  invoiceNumber  String    @unique @map("invoice_number")
  amount         Decimal   @db.Decimal(12, 2)
  taxAmount      Decimal   @default(0) @db.Decimal(12, 2) @map("tax_amount")
  status         String    @default("DRAFT") // DRAFT, SENT, PAID, CANCELLED
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  payments    Payment[]

  @@map("invoices")
}

// ADR-014: Full payment collected via Razorpay; webhook idempotency via unique gateway_reference
model Payment {
  id               String   @id @default(uuid())
  invoiceId        String   @map("invoice_id")
  gateway          String   @default("RAZORPAY")
  gatewayReference String   @unique @map("gateway_reference") // Razorpay payment_id / order_id
  amount           Decimal  @db.Decimal(12, 2)
  status           String   @default("PENDING") // PENDING, CAPTURED, FAILED, REFUNDED
  rawPayload       Json?    @map("raw_payload")
  createdAt        DateTime @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("payments")
}

// ADR-011: Admin-only approval; ADR-014: Separate commission lifecycle
model Commission {
  id            String    @id @default(uuid())
  applicationId String    @map("application_id")
  serviceId     String    @map("service_id")
  partnerId     String    @map("partner_id") // userId with PARTNER role
  baseAmount    Decimal   @db.Decimal(12, 2) @map("base_amount")
  rate          Decimal   @db.Decimal(5, 2) // percentage rate or flat fee
  amount        Decimal   @db.Decimal(12, 2)
  status        String    @default("PENDING") // PENDING, APPROVED, REJECTED, PAID
  approvedById  String?   @map("approved_by_id") // Must be Admin
  approvedAt    DateTime? @map("approved_at")
  rejectionReason String? @map("rejection_reason")
  createdAt     DateTime  @default(now()) @map("created_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  partner     User        @relation("PartnerCommissions", fields: [partnerId], references: [id], onDelete: Cascade)
  approvedBy  User?       @relation("AdminApprovedCommissions", fields: [approvedById], references: [id], onDelete: SetNull)
  payouts     Payout[]

  @@index([partnerId])
  @@index([status])
  @@map("commissions")
}

// ADR-014: Payouts tracked separately
model Payout {
  id              String    @id @default(uuid())
  commissionId    String    @map("commission_id")
  partnerId       String    @map("partner_id")
  amount          Decimal   @db.Decimal(12, 2)
  paymentMethod   String    @default("BANK_TRANSFER") @map("payment_method") // BANK_TRANSFER, RAZORPAYX
  status          String    @default("PENDING_PAYOUT") // PENDING_PAYOUT, PAID, FAILED
  referenceNumber String?   @map("reference_number") // UTR / transaction ID
  paidAt          DateTime? @map("paid_at")
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at")

  commission Commission @relation(fields: [commissionId], references: [id], onDelete: Cascade)
  partner    User       @relation("PartnerPayouts", fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@index([status])
  @@map("payouts")
}

// ─── DOMAIN 10: AUDIT & LOGGING ─────────────────────────────────────────────

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?  @map("organization_id")
  userId         String?  @map("user_id")
  action         String   // e.g. "auth.login", "lead.assign", "commission.approve"
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  oldValues      Json?    @map("old_values")
  newValues      Json?    @map("new_values")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, action])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model NotificationLog {
  id                String    @id @default(uuid())
  organizationId    String?   @map("organization_id")
  userId            String?   @map("user_id")
  channel           String    // EMAIL, SMS, WHATSAPP, IN_APP
  eventType         String    @default("system.generic") @map("event_type")
  recipient         String
  subject           String?
  body              String
  status            String    @default("PENDING") // PENDING, SENT, FAILED, DELIVERED
  provider          String    @default("MOCK") // RESEND, MSG91, INTERAKT, MOCK
  providerMessageId String?   @map("provider_message_id")
  idempotencyKey    String?   @unique @map("idempotency_key")
  attempts          Int       @default(1)
  errorMessage      String?   @map("error_message")
  metadata          Json?
  sentAt            DateTime? @map("sent_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([organizationId, channel])
  @@index([recipient])
  @@index([status])
  @@map("notification_logs")
}

// ─── DOMAIN 13: CMS & KNOWLEDGE BASE DOMAIN ─────────────────────────────────

model BlogCategory {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  name           String
  slug           String    @unique
  description    String?
  icon           String?
  sortOrder      Int       @default(0) @map("sort_order")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  posts          BlogPost[]

  @@map("blog_categories")
}

model BlogPost {
  id              String    @id @default(uuid())
  organizationId  String    @map("organization_id")
  categoryId      String?   @map("category_id")
  authorId        String?   @map("author_id")
  title           String
  slug            String    @unique
  excerpt         String
  content         String    @db.Text
  coverImage      String?   @map("cover_image")
  readingTimeMin  Int       @default(5) @map("reading_time_min")
  status          String    @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  publishedAt     DateTime? @map("published_at")
  tags            String[]  @default([])
  featured        Boolean   @default(false)
  viewCount       Int       @default(0) @map("view_count")

  // SEO Metadata
  metaTitle       String?   @map("meta_title")
  metaDescription String?   @map("meta_description")
  metaKeywords    String?   @map("meta_keywords")
  canonicalUrl    String?   @map("canonical_url")
  ogTitle         String?   @map("og_title")
  ogDescription   String?   @map("og_description")
  ogImage         String?   @map("og_image")
  twitterCard     String?   @default("summary_large_image") @map("twitter_card")

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category        BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author          User?         @relation("AuthorBlogPosts", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([slug])
  @@index([categoryId])
  @@map("blog_posts")
}
