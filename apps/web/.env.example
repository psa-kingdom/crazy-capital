# Crazy Capital Public Web Experience & Customer Portal — Environment Configuration Example
# Copy to .env.local for local development or set in deployment provider (Vercel / Hostinger / Docker)

# Backend REST API endpoint (Slice 1.1 - 2.5)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# In Production: NEXT_PUBLIC_API_URL=https://api.crazycapital.in/api/v1

# Razorpay Checkout Public Key (Safe for browser client)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_mock_crazy_capital_dev
